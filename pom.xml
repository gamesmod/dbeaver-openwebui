<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.dbtools.openwebui</groupId>
    <artifactId>dbeaver-openwebui-parent</artifactId>
    <version>1.0.2-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>DBeaver Open WebUI integration</name>

    <properties>
        <tycho.version>4.0.10</tycho.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Локальная установка DBeaver (каталог, где лежит папка plugins).
             Переопределяется: mvn -Ddbeaver.home=/opt/dbeaver verify -->
        <dbeaver.home>${env.DBEAVER_HOME}</dbeaver.home>
        <eclipse.release>https://download.eclipse.org/releases/2025-06/</eclipse.release>
        <dbeaver.p2>https://dbeaver.io/update/latest/</dbeaver.p2>
    </properties>

    <modules>
        <module>bundles/io.dbtools.openwebui</module>
        <module>features/io.dbtools.openwebui.feature</module>
        <module>releng/io.dbtools.openwebui.site</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-maven-plugin</artifactId>
                <version>${tycho.version}</version>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>target-platform-configuration</artifactId>
                <version>${tycho.version}</version>
                <configuration>
                    <executionEnvironment>JavaSE-21</executionEnvironment>
                    <environments>
                        <environment><os>win32</os><ws>win32</ws><arch>x86_64</arch></environment>
                        <environment><os>linux</os><ws>gtk</ws><arch>x86_64</arch></environment>
                        <environment><os>macosx</os><ws>cocoa</ws><arch>aarch64</arch></environment>
                    </environments>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-compiler-plugin</artifactId>
                <version>${tycho.version}</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- По умолчанию: сборка против локально установленного DBeaver (самый надёжный вариант,
             версии API совпадают с тем DBeaver, куда будет ставиться плагин). -->
        <profile>
            <id>local-dbeaver</id>
            <activation><activeByDefault>true</activeByDefault></activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.eclipse.tycho</groupId>
                        <artifactId>target-platform-configuration</artifactId>
                        <version>${tycho.version}</version>
                        <configuration>
                            <target>
                                <file>${maven.multiModuleProjectDirectory}/releng/dbeaver-local.target</file>
                            </target>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Альтернатива: разрешение зависимостей из p2-репозиториев Eclipse и DBeaver.
             mvn -Pp2 verify -->
        <profile>
            <id>p2</id>
            <repositories>
                <repository>
                    <id>eclipse</id>
                    <layout>p2</layout>
                    <url>${eclipse.release}</url>
                </repository>
                <repository>
                    <id>dbeaver</id>
                    <layout>p2</layout>
                    <url>${dbeaver.p2}</url>
                </repository>
            </repositories>
        </profile>
    </profiles>
</project>
