Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Open WebUI engine for DBeaver AI assistant
Bundle-Vendor: gamesmod
Bundle-SymbolicName: dbeaver.openwebui.ai;singleton:=true
Bundle-Version: 2.0.0.qualifier
Bundle-RequiredExecutionEnvironment: JavaSE-21
Bundle-ActivationPolicy: lazy
Automatic-Module-Name: dbeaver.openwebui.ai
Require-Bundle: org.eclipse.core.runtime,
 org.eclipse.swt,
 org.eclipse.jface,
 org.jkiss.utils,
 org.jkiss.dbeaver.model,
 org.jkiss.dbeaver.model.ai,
 org.jkiss.dbeaver.ui,
 org.jkiss.dbeaver.ui.ai
Import-Package: com.google.gson,
 com.google.gson.annotations,
 com.google.gson.reflect
Export-Package: dbeaver.openwebui.model,
 dbeaver.openwebui.ui
