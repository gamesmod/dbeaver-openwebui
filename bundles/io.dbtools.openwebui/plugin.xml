<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <!-- ========== Настройки ========== -->
   <extension point="org.eclipse.core.runtime.preferences">
      <initializer class="io.dbtools.openwebui.prefs.PrefsInitializer"/>
   </extension>

   <extension point="org.eclipse.ui.preferencePages">
      <page
            id="io.dbtools.openwebui.prefs.main"
            name="Open WebUI"
            class="io.dbtools.openwebui.prefs.OpenWebUIPreferencePage">
         <keywords/>
      </page>
   </extension>

   <!-- ========== Чат-панель ========== -->
   <extension point="org.eclipse.ui.views">
      <category id="io.dbtools.openwebui.views" name="Open WebUI"/>
      <view
            id="io.dbtools.openwebui.views.chat"
            category="io.dbtools.openwebui.views"
            name="Open WebUI: чат"
            icon="icons/openwebui.png"
            class="io.dbtools.openwebui.ui.ChatView"
            allowMultiple="false"/>
   </extension>

   <!-- ========== Команды ========== -->
   <extension point="org.eclipse.ui.commands">
      <category id="io.dbtools.openwebui.commands" name="Open WebUI"/>
      <command id="io.dbtools.openwebui.cmd.generate" categoryId="io.dbtools.openwebui.commands"
               name="Сгенерировать SQL…" description="Построить SQL по описанию на естественном языке с учётом схемы БД"/>
      <command id="io.dbtools.openwebui.cmd.explain" categoryId="io.dbtools.openwebui.commands"
               name="Объяснить запрос" description="Объяснить выделенный или текущий запрос"/>
      <command id="io.dbtools.openwebui.cmd.optimize" categoryId="io.dbtools.openwebui.commands"
               name="Оптимизировать запрос" description="Предложить оптимизированный вариант запроса"/>
      <command id="io.dbtools.openwebui.cmd.review" categoryId="io.dbtools.openwebui.commands"
               name="Найти ошибки в запросе" description="Проверить запрос на ошибки и потенциальные проблемы"/>
      <command id="io.dbtools.openwebui.cmd.chat" categoryId="io.dbtools.openwebui.commands"
               name="Открыть чат Open WebUI" description="Открыть панель чата с моделью"/>
   </extension>

   <extension point="org.eclipse.ui.handlers">
      <handler commandId="io.dbtools.openwebui.cmd.generate" class="io.dbtools.openwebui.handlers.GenerateSqlHandler">
         <activeWhen><reference definitionId="io.dbtools.openwebui.sqlEditorActive"/></activeWhen>
      </handler>
      <handler commandId="io.dbtools.openwebui.cmd.explain" class="io.dbtools.openwebui.handlers.ExplainSqlHandler">
         <activeWhen><reference definitionId="io.dbtools.openwebui.sqlEditorActive"/></activeWhen>
      </handler>
      <handler commandId="io.dbtools.openwebui.cmd.optimize" class="io.dbtools.openwebui.handlers.OptimizeSqlHandler">
         <activeWhen><reference definitionId="io.dbtools.openwebui.sqlEditorActive"/></activeWhen>
      </handler>
      <handler commandId="io.dbtools.openwebui.cmd.review" class="io.dbtools.openwebui.handlers.ReviewSqlHandler">
         <activeWhen><reference definitionId="io.dbtools.openwebui.sqlEditorActive"/></activeWhen>
      </handler>
      <handler commandId="io.dbtools.openwebui.cmd.chat" class="io.dbtools.openwebui.handlers.OpenChatHandler"/>
   </extension>

   <extension point="org.eclipse.core.expressions.definitions">
      <definition id="io.dbtools.openwebui.sqlEditorActive">
         <with variable="activeEditorId">
            <equals value="org.jkiss.dbeaver.ui.editors.sql.SQLEditor"/>
         </with>
      </definition>
   </extension>

   <!-- ========== Меню ========== -->
   <extension point="org.eclipse.ui.menus">
      <!-- Контекстное меню SQL-редактора DBeaver (SQLEditorContributions.SQL_EDITOR_CONTEXT_MENU_ID) -->
      <menuContribution locationURI="popup:#SQLEditorContext?after=additions">
         <menu id="io.dbtools.openwebui.menu.popup" label="Open WebUI" icon="icons/openwebui.png">
            <command commandId="io.dbtools.openwebui.cmd.generate" icon="icons/openwebui.png"/>
            <separator name="query" visible="true"/>
            <command commandId="io.dbtools.openwebui.cmd.explain"/>
            <command commandId="io.dbtools.openwebui.cmd.optimize"/>
            <command commandId="io.dbtools.openwebui.cmd.review"/>
            <separator name="chat" visible="true"/>
            <command commandId="io.dbtools.openwebui.cmd.chat"/>
         </menu>
      </menuContribution>

      <!-- Главное меню -->
      <menuContribution locationURI="menu:org.eclipse.ui.main.menu?after=additions">
         <menu id="io.dbtools.openwebui.menu.main" label="Open WebUI">
            <command commandId="io.dbtools.openwebui.cmd.generate"/>
            <command commandId="io.dbtools.openwebui.cmd.explain"/>
            <command commandId="io.dbtools.openwebui.cmd.optimize"/>
            <command commandId="io.dbtools.openwebui.cmd.review"/>
            <separator name="chat" visible="true"/>
            <command commandId="io.dbtools.openwebui.cmd.chat"/>
            <command commandId="org.eclipse.ui.window.preferences" label="Настройки…">
               <parameter name="preferencePageId" value="io.dbtools.openwebui.prefs.main"/>
            </command>
         </menu>
      </menuContribution>
   </extension>

   <!-- ========== Горячие клавиши (M1 = Ctrl/Cmd, M2 = Shift, M3 = Alt) ========== -->
   <extension point="org.eclipse.ui.bindings">
      <key commandId="io.dbtools.openwebui.cmd.generate" sequence="M1+M2+M3+G"
           contextId="org.jkiss.dbeaver.ui.editors.sql.script.focused"
           schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key commandId="io.dbtools.openwebui.cmd.explain" sequence="M1+M2+M3+E"
           contextId="org.jkiss.dbeaver.ui.editors.sql.script.focused"
           schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
      <key commandId="io.dbtools.openwebui.cmd.optimize" sequence="M1+M2+M3+P"
           contextId="org.jkiss.dbeaver.ui.editors.sql.script.focused"
           schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
   </extension>

</plugin>
