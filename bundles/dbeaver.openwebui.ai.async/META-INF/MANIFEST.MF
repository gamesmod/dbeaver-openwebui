Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Open WebUI background chats for DBeaver AI assistant
Bundle-Vendor: gamesmod
Bundle-SymbolicName: dbeaver.openwebui.ai.async;singleton:=true
Bundle-Version: 2.3.0.qualifier
Bundle-RequiredExecutionEnvironment: JavaSE-21
Bundle-ActivationPolicy: lazy
Bundle-Localization: OSGI-INF/l10n/bundle
Automatic-Module-Name: dbeaver.openwebui.ai.async
Require-Bundle: org.eclipse.core.runtime,
 org.eclipse.swt,
 org.eclipse.jface,
 org.eclipse.ui.workbench,
 org.jkiss.utils,
 org.jkiss.dbeaver.model,
 org.jkiss.dbeaver.model.ai;bundle-version="[2.0.29,3.0.0)",
 org.jkiss.dbeaver.ui,
 org.jkiss.dbeaver.ui.ai;bundle-version="[1.0.88,2.0.0)",
 dbeaver.openwebui.ai;bundle-version="[2.3.0,3.0.0)"
Import-Package: com.google.gson,
 com.google.gson.annotations,
 com.google.gson.reflect
Export-Package: dbeaver.openwebui.async,
 dbeaver.openwebui.async.core
