<?xml version="1.0" encoding="UTF-8"?>
<feature
      id="io.dbtools.openwebui.feature"
      label="Open WebUI for DBeaver"
      version="1.0.2.qualifier"
      provider-name="dbtools">

   <description>
      Интеграция DBeaver с Open WebUI: генерация SQL по описанию, объяснение, оптимизация и проверка запросов,
      чат с моделью с учётом структуры базы данных.
   </description>

   <license url="https://opensource.org/licenses/MIT">
      MIT License
   </license>

   <requires>
      <import plugin="org.jkiss.dbeaver.model"/>
      <import plugin="org.jkiss.dbeaver.ui"/>
      <import plugin="org.jkiss.dbeaver.ui.editors.base"/>
      <import plugin="org.jkiss.dbeaver.ui.editors.sql"/>
   </requires>

   <plugin
         id="io.dbtools.openwebui"
         version="0.0.0"
         unpack="false"/>
</feature>
